# --- Server ---
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# --- Supabase ---
# Li trovi in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=incolla-qui-la-anon-public-key
# ATTENZIONE: la service role key bypassa la Row Level Security.
# Deve stare SOLO qui (backend), MAI nel frontend, MAI su GitHub.
SUPABASE_SERVICE_ROLE_KEY=incolla-qui-la-service-role-key

# Nessuna variabile per l'IA: il programma non chiama nessuna API di IA.
# Il giocatore usa la IA che preferisce (ChatGPT, Gemini, Claude, ecc.)
# copiando e incollando il testo che l'app prepara.
